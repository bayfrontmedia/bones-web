{
  "private": true,
  "scripts": {
    "app:update": "npm update && cp node_modules/@bayfrontmedia/skin/dist/js/skin.js storage/public/assets/js/skin.js",
    "watch:styles": "npx @tailwindcss/cli -i src/css/app.css -o storage/public/assets/css/app.css --watch",
    "build:styles": "npx @tailwindcss/cli -i src/css/app.css -o storage/public/assets/css/app.css",
    "build:styles:prod": "npx @tailwindcss/cli -i src/css/app.css -o storage/public/assets/css/app.css --minify",
    "watch:webpack": "webpack --mode development --watch",
    "build:webpack": "webpack --mode development",
    "build:webpack:prod": "webpack --mode production",
    "build:prod": "npm run app:update && npm run build:webpack:prod && npm run build:styles:prod"
  },
  "devDependencies": {
    "@bayfrontmedia/skin": "^3.1.3",
    "@tailwindcss/forms": "^0.5.10",
    "webpack": "^5.90",
    "webpack-cli": "^5.1"
  },
  "dependencies": {
    "@tailwindcss/cli": "^4.0"
  }
}
